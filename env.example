# Blockchain Deployment Configuration
# Copy this file to .env and fill in your values

# Deployer wallet private key (NEVER commit the actual .env file!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Base RPC URLs (use Alchemy, Infura, or QuickNode)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key_here

# DeBank API Configuration
# Get your API key from https://debank.com/api
DEBANK_API_KEY=your_debank_api_key_here
DEBANK_API_URL=https://pro-openapi.debank.com/v1

# Optional: For production deployment
NEXT_PUBLIC_ENABLE_REAL_WALLET_TRACKING=true
